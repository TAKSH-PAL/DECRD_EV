# ==============================================================================
# CARBON-AWARE EV DEPOT ORCHESTRATOR - AWS CONFIGURATION
# ==============================================================================
# Paste your AWS credentials below to connect the live system to real AWS services:
# - Amazon Bedrock (Claude 3.5 Sonnet / Haiku)
# - Amazon DynamoDB (Fleet, Charger, and Schedule tables)
# - Amazon EventBridge (Disruption and telemetry bus)
# - Amazon CloudWatch (Real operational metrics)
# ==============================================================================

AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_key_here
AWS_DEFAULT_REGION=us-east-1

# Optional: Session Token (if using temporary credentials or AWS Academy / Learner Lab)
# AWS_SESSION_TOKEN=

# Amazon Bedrock Foundation Model
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0

# Amazon EventBridge Bus Name
EVENTBRIDGE_BUS_NAME=default

# Amazon DynamoDB Table Prefix
DYNAMODB_TABLE_PREFIX=EVDepot
